<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="publish\**" />
	  <EmbeddedResource Remove="publish\**" />
	  <None Remove="publish\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- AccessTools/AccessOleDb/AccessComAutomation etc. live in DigitalJeeves.MsAccessMCP.Core so other hosts can
         reference them in-process. This project is just the standalone stdio MCP host (Program.cs). -->
		<ProjectReference Include="..\AccessMCP.Core\DigitalJeeves.MsAccessMCP.Core.csproj" />
		<PackageReference Include="ModelContextProtocol" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
